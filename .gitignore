# Amara Unfold public-repository boundary
#
# This working tree also contains private project continuity and local build/UAT
# material. Those files must remain beside the source locally, but must never be
# added to the public Git history. The public-source audit remains the second,
# content-aware safety gate; .gitignore is the first line of defence.

# Private project continuity and agent/tool state
/AGENTS.md
/project-memory/
/.claude/
/.codex/
/.cursor/
/.idea/
/.vscode/

# Personal inputs, app exports, generated Markdown, UAT evidence, and backups
private-data/
personal-data/
raw-data/
[Rr][Aa][Ww]/
local-data/
[Tt]akeout*/
[Bb]ackup*/
[Mm]etadata[ -][Ee]xtract/
[Aa]mara-[Uu]nfold-[Uu][Aa][Tt]/

# Dependencies and generated build output
node_modules/
target/
dist/
build/
out/
.cache/
.parcel-cache/
.turbo/
.vite/
apps/desktop/src-tauri/gen/
*.tsbuildinfo

# Test and coverage output
coverage/
playwright-report/
test-results/
blob-report/
.nyc_output/

# Runtime databases, indexes, and temporary state
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
*.tmp
*.temp
*.swp
*.swo
*~

# Secrets, credentials, certificates, and local environment configuration
.env
.env.*
!.env.example
.npmrc
.netrc
*.cer
*.crt
*.key
*.mobileprovision
*.p12
*.pem
*.pfx
*.provisionprofile

# Personal/raw export formats and source archives
# These are deliberately fail-closed. Public fixtures must be synthetic,
# reviewed, and explicitly approved by changing both this file and the audit.
*.7z
*.csv
*.docx
*.eml
*.gz
*.heic
*.jpeg
*.jpg
*.kml
*.kmz
*.m4a
*.mbox
*.mov
*.mp3
*.mp4
*.ods
*.ost
*.pdf
*.pst
*.rar
*.tar
*.tar.gz
*.tgz
*.tsv
*.wav
*.xls
*.xlsx
*.zip

# Packaged applications and installers are release artifacts, not source
*.app/
*.dmg
*.pkg

# Logs and diagnostic captures
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating-system metadata
.DS_Store
._*
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
